---
import { siGithub } from "simple-icons";
import data from "../data/proyectos.json";

// Una librea distinta por viaje.
const libreas = ["#2f6fd0", "#c8261a", "#ffb000", "#1fa774", "#6b3fa0"];
const numero = (i: number) => String(i + 1).padStart(4, "0");
// Un link a github.com/usuario es el perfil, no el código del proyecto.
const esRepo = (url?: string) => !!url && new URL(url).pathname.split("/").filter(Boolean).length >= 2;
---

<section id="proyectos" class="proyectos">
  <div class="proy-head">
    <h2>Proyectos</h2>
    <p>Cada viaje, un boleto. Arranco por el más reciente, MgDetailing, ya en producción. Tres más los hice para clientes; los otros, para aprender y probar ideas.</p>
  </div>

  {data.proyectos.map((p, i) => (
    <article class="viaje" style={`--band: ${libreas[i % libreas.length]}`} aria-labelledby={`proy-${i}`}>
      <div class="viaje-inner">
        <div class="maquina">
          <div class="boletera" aria-hidden="true">
            <span class="boletera-num">Línea M</span>
            <span class="slot"></span>
          </div>
          <div class="salida">
            <div class="boleto">
              <h3 id={`proy-${i}`}>{p.name}</h3>
              <p class="desc">{p.descripcion}</p>
              <ul class="techs" aria-label="Tecnologías">
                {p.tecnologias.map((t) => <li>{t.name}</li>)}
              </ul>
              <div class="boleto-foot">
                <div class="links">
                  {p.web && (
                    <a class="link" href={p.web} target="_blank" rel="noopener noreferrer">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14zM5 5h6v2H5v12h12v-6h2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z" /></svg>
                      Ver sitio
                      <span class="sr-only">de {p.name} (se abre en otra pestaña)</span>
                    </a>
                  )}
                  {p.git && (
                    <a class={p.web ? "link link-alt" : "link"} href={p.git} target="_blank" rel="noopener noreferrer">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path} /></svg>
                      {esRepo(p.git) ? "Ver código" : "Ver GitHub"}
                      <span class="sr-only">de {p.name} en GitHub (se abre en otra pestaña)</span>
                    </a>
                  )}
                </div>
                {p.nuevo && <span class="sello sello-nuevo">Nuevo</span>}
                {p.cliente && <span class="sello">Cliente real</span>}
              </div>
              <p class="serie" aria-hidden="true">Línea M · Boleto Nº {numero(i)}</p>
            </div>
          </div>
        </div>

        <figure class="vidrio">
          {p.video && (
            <video controls preload="none" poster={p.poster} playsinline aria-label={`Video del proyecto ${p.name}`}>
              <source src={p.video} type="video/mp4" />
              Tu navegador no puede reproducir este video.
            </video>
          )}
          {p.image && (
            <img src={p.image} alt={`Captura del proyecto ${p.name}`} loading="lazy" />
          )}
        </figure>
      </div>
    </article>
  ))}
</section>

<style>
  .proyectos { background: var(--navy); }

  .proy-head {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(80px, 11vw, 140px) var(--gutter) clamp(40px, 6vw, 72px);
  }
  h2 {
    margin: 0;
    font-size: clamp(3.4rem, 11vw, 9rem);
    color: var(--white);
  }
  .proy-head p {
    max-width: 52ch;
    margin: 16px 0 0;
    font-size: 1.2rem;
    color: var(--muted-on-navy);
  }

  /* Cada proyecto es una banda de librea a todo el ancho */
  .viaje {
    background: var(--band);
    padding: clamp(56px, 8vw, 110px) var(--gutter);
    overflow-x: clip;
  }
  .viaje-inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    max-width: 1180px;
    margin: 0 auto;
  }
  .viaje:nth-of-type(even) .maquina { order: 2; }

  /* Boletera: la máquina que imprime el boleto */
  .boletera {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 54px;
    padding: 0 18px;
    border-radius: 14px 14px 6px 6px;
    background: linear-gradient(#2c3550, #141b30);
    box-shadow: 0 10px 20px -8px rgba(0, 0, 0, 0.5);
  }
  .boletera-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.14em;
    color: var(--amber);
    text-shadow: 0 0 8px rgba(255, 176, 0, 0.55);
  }
  .slot {
    width: 58%;
    height: 8px;
    border-radius: 4px;
    background: #03060e;
    box-shadow: inset 0 2px 3px rgba(0, 0, 0, 0.9);
  }
  .salida {
    margin: -6px 18px 0;
    clip-path: inset(0 -60px -80px -60px);
  }

  /* El boleto de papel, con bordes troquelados */
  .boleto {
    --perf: radial-gradient(circle 6px at 50% 0, #0000 97%, #000) top / 18px 51% repeat-x,
      radial-gradient(circle 6px at 50% 100%, #0000 97%, #000) bottom / 18px 51% repeat-x;
    padding: 30px clamp(20px, 3vw, 32px) 32px;
    background:
      linear-gradient(90deg, transparent 0 calc(100% - 3px), rgba(11, 26, 58, 0.04) 0) 0 0 / 22px 100%,
      var(--paper);
    color: var(--ink);
    -webkit-mask: var(--perf);
    mask: var(--perf);
    filter: drop-shadow(0 18px 18px rgba(0, 0, 0, 0.28));
  }
  h3 {
    margin: 0;
    font-size: clamp(2.4rem, 4.6vw, 3.6rem);
    color: var(--ink);
  }
  .desc {
    margin: 12px 0 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
  }
  /* Tecnologías impresas como renglones del boleto */
  .techs {
    display: flex;
    flex-wrap: wrap;
    margin: 18px 0 0;
    padding: 10px 0 0;
    list-style: none;
    border-top: 2px dotted rgba(11, 26, 58, 0.35);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .techs li + li::before {
    content: "/";
    margin: 0 0.5em;
    color: var(--red);
  }
  .boleto-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 26px;
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border-radius: 999px;
    background: var(--navy);
    color: var(--white);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: background-color 150ms, color 150ms, transform 150ms var(--ease-out);
  }
  .links { display: flex; flex-wrap: wrap; gap: 10px; }
  .link svg { width: 20px; height: 20px; fill: currentColor; }
  /* Segundo botón cuando hay sitio y código: contorno en vez de relleno */
  .link-alt { background: transparent; color: var(--navy); box-shadow: inset 0 0 0 3px var(--navy); }
  .link:hover { background: var(--amber); color: var(--navy); transform: translateY(-2px); }
  .link:active { transform: translateY(1px); }

  .serie {
    margin: 24px 0 0;
    padding-top: 12px;
    border-top: 2px dashed rgba(11, 26, 58, 0.35);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .sello {
    padding: 6px 12px;
    border: 3px solid var(--red);
    border-radius: 6px;
    color: var(--red);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.15rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transform: rotate(-6deg);
  }
  .sello-nuevo { border-color: var(--navy); color: var(--navy); }

  /* Ventanilla del colectivo con el proyecto en marcha */
  .vidrio {
    margin: 0;
    padding: 12px;
    border-radius: var(--radius-window);
    background: var(--navy-deep);
    box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.55);
  }
  .vidrio video,
  .vidrio img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: calc(var(--radius-window) - 12px);
    background: #000;
  }
  .vidrio img[src*="bot"] {
    object-fit: contain;
    background: var(--white);
    padding: 12%;
  }

  @media (max-width: 860px) {
    .viaje-inner { grid-template-columns: 1fr; }
    .viaje:nth-of-type(even) .maquina { order: 0; }
  }

  /* Al llegar a la parada: el boleto sale impreso y la ventanilla frena */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .boleto { transform: translateY(-101%); }
    :global(.js) .sello { opacity: 0; }
    :global(.js) .vidrio { opacity: 0; transform: translateX(var(--llegada, 80px)); }
    .viaje:nth-of-type(even) { --llegada: -80px; }

    .viaje.en-parada .boleto { animation: imprimir 1200ms linear forwards; }
    .viaje.en-parada .sello { animation: sellar 380ms var(--ease-out) 1250ms forwards; }
    :global(.js) .viaje.en-parada .vidrio {
      transform: none;
      opacity: 1;
      transition: transform 1100ms var(--ease-out), opacity 500ms;
    }
  }

  @keyframes imprimir {
    0% { transform: translateY(-101%); }
    16% { transform: translateY(-76%); }
    24% { transform: translateY(-76%); }
    40% { transform: translateY(-50%); }
    48% { transform: translateY(-50%); }
    64% { transform: translateY(-25%); }
    72% { transform: translateY(-25%); }
    90% { transform: translateY(1.5%); }
    100% { transform: translateY(0); }
  }
  @keyframes sellar {
    0% { opacity: 0; transform: rotate(-14deg) scale(1.8); }
    100% { opacity: 1; transform: rotate(-6deg) scale(1); }
  }
</style>

<script>
  const viajes = document.querySelectorAll<HTMLElement>(".viaje");
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add("en-parada");
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.25 },
  );
  viajes.forEach((v) => io.observe(v));
</script>
