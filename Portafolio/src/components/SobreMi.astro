---
import { siGithub } from "simple-icons";

const mensajes = ["Gimenez Mateo", "Desarrollador web", "JavaScript · React · Node.js", "¿Subís? Escribime"];
// LinkedIn no está en simple-icons; trazado del logo oficial.
const linkedinPath =
  "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z";
---

<section id="inicio" class="hero">
  <div class="sign" role="img" aria-label="Cartel de destino: Gimenez Mateo, desarrollador web">
    <div class="sign-route" aria-hidden="true">
      <span>Línea</span>
      <strong>M</strong>
    </div>
    <div class="sign-screen">
      <canvas class="led" data-messages={JSON.stringify(mensajes)} aria-hidden="true"></canvas>
    </div>
  </div>

  <div class="hero-body">
    <figure class="ventanilla">
      <img src="/imgCurriculum.jpg" alt="Foto de Mateo Gimenez" width="400" height="500" fetchpriority="high" />
    </figure>

    <div class="hero-copy">
      <h1>Gimenez Jorge Mateo</h1>
      <p class="rol">Técnico en Programación · Desarrollador web</p>
      <p class="bio">
        ¡Hola! Soy desarrollador web junior y trabajo con <strong>JavaScript, React y Node.js</strong>. Ya hice sistemas y
        sitios para clientes reales: una joyería, un gimnasio y un bot de WhatsApp. Me gusta resolver problemas
        concretos y aprender algo nuevo en cada proyecto.
      </p>
      <div class="acciones">
        <a class="btn-ticket" href="/CV - Giménez, Mateo.pdf" download="Curriculum Mateo Gimenez 2025.pdf">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11 3h2v10.17l3.59-3.58L18 11l-6 6-6-6 1.41-1.41L11 13.17zM5 19h14v2H5z" /></svg>
          Descargar CV
        </a>
        <a class="btn-round" href="https://www.linkedin.com/in/mateo-gimenez-80702b309/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (se abre en otra pestaña)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={linkedinPath} /></svg>
        </a>
        <a class="btn-round" href="https://github.com/MateoGimenez" target="_blank" rel="noopener noreferrer" aria-label="GitHub (se abre en otra pestaña)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path} /></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="livery" aria-hidden="true"><span></span><span></span><span></span></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--header-h) + clamp(20px, 4vw, 48px));
    background: var(--navy);
  }

  /* Carcasa del cartel de destino */
  .sign {
    display: flex;
    align-items: stretch;
    gap: clamp(8px, 1.4vw, 18px);
    margin: 0 var(--gutter);
    padding: clamp(10px, 1.6vw, 20px);
    background: #120d05;
    border-radius: 18px;
    box-shadow:
      inset 0 0 0 2px #2b2418,
      inset 0 8px 24px rgba(0, 0, 0, 0.7),
      0 18px 40px -12px rgba(0, 0, 0, 0.6);
  }
  .sign-route {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-width: clamp(56px, 9vw, 130px);
    padding: 6px 10px;
    background: var(--red);
    color: var(--white);
    border-radius: 10px;
    font-family: var(--font-display);
    text-transform: uppercase;
    line-height: 0.85;
  }
  .sign-route span { font-weight: 700; font-size: clamp(0.7rem, 1.2vw, 1rem); letter-spacing: 0.12em; }
  .sign-route strong { font-weight: 900; font-size: clamp(2.6rem, 8vw, 7rem); }
  .sign-screen {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    padding: clamp(4px, 0.8vw, 10px);
    background: #0a0703;
    border-radius: 10px;
  }
  .led {
    display: block;
    width: 100%;
  }

  .hero-body {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(200px, 340px) minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 5vw, 80px);
    max-width: 1180px;
    width: 100%;
    margin: 0 auto;
    padding: clamp(32px, 6vw, 72px) var(--gutter);
  }

  /* Ventanilla del colectivo */
  .ventanilla {
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-window);
    padding: 10px;
    background: var(--navy-deep);
    box-shadow:
      inset 0 0 0 2px rgba(255, 255, 255, 0.08),
      0 24px 48px -16px rgba(0, 0, 0, 0.6);
  }
  .ventanilla img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: calc(var(--radius-window) - 10px);
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 8vw, 6rem);
    color: var(--white);
  }
  .rol {
    margin: 14px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--amber);
  }
  .bio {
    max-width: 60ch;
    margin: 18px 0 0;
    color: var(--muted-on-navy);
    font-size: 1.125rem;
  }
  .bio strong { color: var(--white); font-weight: 650; }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 30px;
  }

  /* Mobile: la ventanilla chica al lado del nombre, para que el CV entre en la primera pantalla */
  @media (max-width: 760px) {
    .hero-body {
      grid-template-columns: 112px minmax(0, 1fr);
      align-items: start;
      align-content: center;
      gap: 18px 20px;
      padding-top: 28px;
    }
    .ventanilla { padding: 6px; border-radius: 20px; }
    .ventanilla img { border-radius: 14px; }
    .hero-copy { display: contents; }
    h1 { grid-column: 2; align-self: center; font-size: clamp(2.2rem, 10vw, 3rem); }
    .rol, .bio, .acciones { grid-column: 1 / -1; margin-top: 0; }
    .bio { font-size: 1.05rem; }
    .acciones { margin-top: 4px; }
  }

  /* Secuencia de entrada: el colectivo llega a la parada */
  @media (prefers-reduced-motion: no-preference) {
    .sign { animation: sign-in 700ms var(--ease-out) both; }
    .ventanilla { animation: window-open 900ms var(--ease-out) 500ms both; }
    h1, .rol { animation: wipe-in 800ms var(--ease-out) both; }
    h1 { animation-delay: 1000ms; }
    .rol { animation-delay: 1150ms; }
    .bio, .acciones { animation: rise 700ms var(--ease-out) both; }
    .bio { animation-delay: 1300ms; }
    .acciones { animation-delay: 1420ms; }
    .livery > span { animation: stripe 1100ms var(--ease-out) both; transform-origin: left; }
    .livery > span:nth-child(2) { animation-delay: 120ms; }
    .livery > span:nth-child(3) { animation-delay: 240ms; }
  }

  @keyframes sign-in {
    from { opacity: 0; transform: translateY(-24px) scale(0.98); }
  }
  @keyframes window-open {
    from { clip-path: inset(100% 0 0 0 round var(--radius-window)); }
    to { clip-path: inset(0 0 0 0 round var(--radius-window)); }
  }
  @keyframes wipe-in {
    from { clip-path: inset(0 100% 0 0); transform: translateX(-12px); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(16px); }
  }
  @keyframes stripe {
    from { transform: scaleX(0); }
  }
</style>

<script>
  import { LedSign } from "../scripts/led";

  const canvas = document.querySelector<HTMLCanvasElement>(".hero .led");
  if (canvas) {
    new LedSign(canvas, {
      messages: JSON.parse(canvas.dataset.messages ?? "[]"),
      intro: true,
      targetCols: 84,
    });
  }
</script>
