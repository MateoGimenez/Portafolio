---
import * as icons from "simple-icons";
import skillsData from "../data/skills.json";

type Icon = { path: string };
const getIcon = (key: string) => (icons as unknown as Record<string, Icon>)[key];

---

<section id="skills" class="skills">
  <div class="inner">
    <div class="intro">
      <h2>Lo que llevo a bordo</h2>
      <p>Lenguajes, frameworks y herramientas con los que construyo cada proyecto.</p>
    </div>

    <div class="placa">
      <div class="columnas">
        {skillsData.skills.map((cat) => (
          <div class="columna">
            <h3>{cat.category}</h3>
            <ul>
              {cat.items.map((skill) => {
                const icon = getIcon(skill.icon);
                return (
                  <li>
                    {icon && (
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d={icon.path} />
                      </svg>
                    )}
                    <span>{skill.name}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .skills {
    background: var(--yellow);
    color: var(--navy);
    padding: clamp(72px, 10vw, 128px) var(--gutter);
  }
  .inner {
    max-width: 1180px;
    margin: 0 auto;
  }
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 12px 40px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  h2 {
    margin: 0;
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    color: var(--navy);
  }
  .intro p {
    max-width: 38ch;
    margin: 0;
    font-size: 1.125rem;
    color: var(--ink);
  }

  /* Cartel blanco de recorrido, atornillado al parabrisas */
  .placa {
    position: relative;
    padding: clamp(28px, 4vw, 48px);
    background: var(--white);
    border-radius: 20px;
    box-shadow: 0 24px 48px -20px rgba(11, 26, 58, 0.45);
  }
  .columnas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 56px);
  }
  h3 {
    margin: 0 0 14px;
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    color: var(--red);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 0;
    border-top: 1px solid #dfe3ec;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1;
    text-transform: uppercase;
  }
  li svg {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    fill: var(--navy);
    transition: transform 200ms var(--ease-out);
  }
  li:hover svg { transform: scale(1.18) rotate(-6deg); }

  @media (max-width: 820px) {
    .columnas { grid-template-columns: 1fr; }
  }
</style>
