---
import "@fontsource/big-shoulders-display/latin-700";
import "@fontsource/big-shoulders-display/latin-800";
import "@fontsource/big-shoulders-display/latin-900";
import "@fontsource-variable/archivo";
import "../styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

const description =
  "Portafolio de Mateo Gimenez, desarrollador web (JavaScript, React y Node.js). Proyectos para clientes reales, skills y contacto.";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1a3a" />
    <meta property="og:title" content="Mateo Gimenez · Desarrollador web" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/portafoli.PNG" />
    <meta property="og:image:alt" content="Captura del portafolio de Mateo Gimenez" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Mateo Gimenez · Desarrollador web</title>
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
